# The BigWigs packager's settings (.github/workflows/release.yml). The addon
# is addon/Hearthtale, shipped as it is (one zip for every game: each loads
# its own TOC); the rest of the repository stays out (the release checks the
# package is the folder, nothing more). The notes are the tag's message,
# written to .release-notes.md by the workflow.
package-as: Hearthtale

move-folders:
  Hearthtale/addon/Hearthtale: Hearthtale

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - addon/test
  - addon/CURSEFORGE.md
  - apps
  - assets
  - docs
  - packages
  - scripts
  - writing
  - AGENTS.md
  - CLAUDE.md
  - LICENSE
  - PLAN.md
  - README.md
  - bun.lock
  - commitlint.config.mjs
  - eslint.config.mjs
  - package.json
  - selene.toml
  - stylua.toml
  - turbo.json
  - vercel.json
  - wow.yml
