    },
    "spells": {
      "lua": "addon/Hearthtale/Client_*.lua",
      "at": "client.spells"
    },
    "bosses": {
      "lua": "addon/Hearthtale/Client_*.lua",
      "at": "client.encounters"
    },
    "mounts": {
      "lua": "addon/Hearthtale/Client_*.lua",
      "at": "client.mounts"
    },
    "flight points": {
      "lua": "addon/Hearthtale/Client_*.lua",
      "at": "client.taxiIds"
    },
    "building areas (Forever)": {
      "json": "i18n/*/subzones.json",
      "at": "forever"
    },
    "building areas (Classic)": {
      "json": "i18n/*/subzones.json",
      "at": "classic"
    },
    "quest stories": {
      "lua": "addon/Hearthtale/Data_*.lua",
      "at": "data.why"
    },
    "class quests": {
      "lua": "addon/Hearthtale/Knowledge.lua",
      "at": [
        "knowledge.quests"
      ]
    },
    "quest chains": {
      "lua": "addon/Hearthtale/Knowledge.lua",
      "at": [
        "knowledge.chains",
        "knowledge.ends"
      ]
    },
    "class quests (Forever)": {
      "lua": "addon/Hearthtale/Forever.lua",
      "before": [
        "addon/Hearthtale/Names.lua",
        "addon/Hearthtale/Knowledge.lua"
      ],
      "at": [
        "knowledge.quests"
      ]
    },
    "quest chains (Forever)": {
      "lua": "addon/Hearthtale/Forever.lua",
      "before": [
        "addon/Hearthtale/Names.lua",
        "addon/Hearthtale/Knowledge.lua"
      ],
      "at": [
        "knowledge.chains",
        "knowledge.ends"
      ]
    }
  },
  "removed": [
    {
