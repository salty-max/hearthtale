{
  "//": "The tables naming the ids a saved file keeps (Ids.lua): a regeneration never drops one (bun run ids, in addon:check). An id leaves on purpose only with the user's go: under removed, with why and approved.",
  "tables": {
    "creatures": {
      "lua": "addon/Hearthtale/English_*.lua",
      "at": "englishNames().creatures"
    },
    "quests": {
      "lua": "addon/Hearthtale/English_*.lua",
      "at": "englishNames().quests"
    },
