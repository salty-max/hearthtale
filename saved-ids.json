      "at": "client.areas"
    },
    "building areas": {
      "lua": "addon/Hearthtale/Client_*.lua",
      "at": "client.inside"
    },
    "dungeons": {
      "lua": "addon/Hearthtale/Client_*.lua",
      "at": "client.maps"
    },
    "creature types": {
      "lua": "addon/Hearthtale/Client_*.lua",
      "at": "client.typeIds"
    },
    "creature families": {
      "lua": "addon/Hearthtale/Client_*.lua",
