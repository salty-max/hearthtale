{
  "name": "@hearthtale/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3002 bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@hearthtale/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@vercel/functions": "^3.9.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
