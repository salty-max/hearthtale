# Local Postgres from `bun run db` (this is also the default when unset).
DATABASE_URL=postgres://hearthtale:hearthtale@localhost:5435/hearthtale

# Optional: LOG_FORMAT=json|pretty, LOG_LEVEL=debug|info|warn|error.

# Production (Vercel + Neon, set by the integration): DATABASE_URL is Neon's
# pooled connection, DATABASE_URL_UNPOOLED the direct one (migrations).

# Battle.net API client (develop.battle.net): sign-in and the characters it finds.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=

# The site's public origin: sign-in returns to $APP_ORIGIN/api/auth/callback, which
# must be listed on develop.battle.net. Local default: http://localhost:5175.
# APP_ORIGIN=
