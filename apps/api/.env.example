# Local Postgres from `bun run db` (this is also the default when unset).
DATABASE_URL=postgres://hearthtale:hearthtale@localhost:5435/hearthtale

# Optional: LOG_FORMAT=json|pretty, LOG_LEVEL=debug|info|warn|error.

# Vercel + Supabase only: DATABASE_URL is the transaction pooler (port 6543),
# MIGRATE_URL the session pooler (port 5432), used by migrations at deploy.
# MIGRATE_URL=
